{
  "name": "ContactRequest",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "description": "Nom complet du demandeur"
    },
    "entreprise": {
      "type": "string",
      "description": "Nom de l'entreprise"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Adresse email"
    },
    "telephone": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone"
    },
    "service": {
      "type": "string",
      "enum": [
        "securite_evenementielle",
        "gardiennage_chantier",
        "maitre_chien",
        "portiers",
        "autre"
      ],
      "description": "Type de service recherch\u00e9"
    },
    "message": {
      "type": "string",
      "description": "Message d\u00e9taill\u00e9"
    },
    "statut": {
      "type": "string",
      "enum": [
        "nouveau",
        "en_cours",
        "traite"
      ],
      "default": "nouveau",
      "description": "Statut de la demande"
    }
  },
  "required": [
    "nom",
    "email",
    "telephone",
    "service",
    "message"
  ]
}